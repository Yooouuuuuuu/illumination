# Connection and session start, controller -> host (network-and-trust.md §4.3).

shape: sequence_diagram

**.style.stroke: "#1E2A4A"
**.style.font-color: "#1E2A4A"
(** -> **)[*].style.stroke: "#1E2A4A"
(** <- **)[*].style.stroke: "#1E2A4A"
(** <-> **)[*].style.stroke: "#1E2A4A"
(** -> **)[*].style.font-color: "#44506E"
(** <- **)[*].style.font-color: "#44506E"
(** <-> **)[*].style.font-color: "#44506E"

user: Person at controller
ctl: Controller (illum)
host: Host (illum)
owner: Person at host

user.style.fill: "#FFFFFF"
ctl.style.fill: "#FFF68D"
host.style.fill: "#B9EFB0"
owner.style.fill: "#FFFFFF"

user -> ctl: "connect to 100.x.y.z\n(port 28326 unless given)"
ctl -> host: "TCP connect"
ctl <-> host: "TLS 1.3, each side presents\nits self-signed desk certificate"

keys: Keys {
  ctl -> ctl: "host key for this address:\nnew: remember it when accepted\nknown and different: stop"
  ctl -> ctl: "export the media keys"
  host -> host: "export the media keys"
}

ctl -> host: "hello: protocol version, name,\nsystem, capabilities"
host -> ctl: "hello: protocol version, name,\nsystem, capabilities"

door: May this desk connect? {
  host -> host: "the desk's own permission,\nelse the setting for new desks:\nalways / ask / never"
  host -> owner: "ask only: the question\n(name, address, key)"
  owner -> host: "No / This time / Always / Never\n(no answer in 60 s: no)"
}

host -> ctl: "accepted, or denied with a reason"
ctl -> host: "screen_start: display, limits"
host -> ctl: "media_endpoint: UDP port"
ctl -> host: "UDP: punch datagrams, mouse moves" {style.stroke-dash: 3}
host -> ctl: "UDP: video and audio" {style.stroke-dash: 3}
ctl <-> host: "TLS: control, input, cursor, clipboard"
