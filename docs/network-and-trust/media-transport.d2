# The two paths between controller and host (network-and-trust.md §4.4).
# Render with: d2 media-transport.d2 media-transport.svg

vars: {
  d2-config: {
    layout-engine: elk
    pad: 24
  }
}

direction: right

**.style.stroke: "#1E2A4A"
**.style.font-color: "#1E2A4A"
**.style.stroke-width: 2
(** -> **)[*].style.stroke: "#1E2A4A"
(** <- **)[*].style.stroke: "#1E2A4A"
(** -> **)[*].style.font-color: "#44506E"
(** <- **)[*].style.font-color: "#44506E"

ctl: "Controller (illum view)" {
  style.fill: "#DDE6F6"
  style.border-radius: 12
  input: "keyboard, buttons, wheel,\nclipboard, feedback" {style.fill: "#FFFFFF"}
  moves: "mouse moves" {style.fill: "#FFFFFF"}
  window: "decoder → window" {style.fill: "#FFFFFF"}
  speaker: "Opus decoder,\n40 ms buffer" {style.fill: "#FFFFFF"}
}

tcp: "TLS 1.3 over TCP · port 28326\neverything arrives, in order" {
  shape: queue
  style.fill: "#C9DBFF"
}
udp: "UDP · port 28326\nkeys from the TLS session\nnever resent" {
  shape: queue
  style.fill: "#FFF68D"
}

host: "Host (illum)" {
  style.fill: "#DDE6F6"
  style.border-radius: 12
  session: "session,\ninput injection" {style.fill: "#FFFFFF"}
  encoder: "capture → AV1 / H.265\n+ parity packets" {style.fill: "#FFFFFF"}
  sound: "Opus, 5 ms frames\n+ 4+2 parity" {style.fill: "#FFFFFF"}
}

ctl.input -> tcp: "input, clipboard,\nfeedback, probes"
tcp -> host.session
ctl.window <- tcp: "cursor, clipboard,\nquality, notices" {style.stroke-dash: 3}
tcp <- host.session: {style.stroke-dash: 3}

ctl.moves -> udp: "newest wins"
udp -> host.session
ctl.window <- udp: "video"
udp <- host.encoder
ctl.speaker <- udp: "sound"
udp <- host.sound
